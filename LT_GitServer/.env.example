# Copy thành .env rồi sửa:  cp .env.example .env
# Lấy IP Tailscale của máy nhà:  tailscale ip -4
BIND_IP=100.x.x.x
DOMAIN=100.x.x.x
ROOT_URL=http://100.x.x.x:3000/

# UID/GID của user trên máy nhà (chạy `id -u` để xem, thường là 1000)
UID_GID=1000

# Phiên bản Forgejo (số major; tự lấy bản vá mới nhất của major đó)
FORGEJO_VERSION=17
